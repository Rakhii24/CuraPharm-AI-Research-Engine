# ==============================================================================
# CuraPharm AI Process Intelligence Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# --- LLM Provider Settings ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Ollama Fallback Settings (Optional) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- LLM Rate Limiting & Resilience ---
LLM_RPM_LIMIT=15
LLM_REQUEST_DELAY=4.0
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=2.0
LLM_TIMEOUT=60

# --- Research Provider Rate Limiting & Timeouts ---
PUBMED_RPM_LIMIT=180
PUBMED_REQUEST_DELAY=0.4
PUBMED_MAX_RETRIES=2
PUBMED_TIMEOUT=30
PUBMED_MAX_RESULTS=3
PUBMED_TOOL=curapharm_research
PUBMED_EMAIL=
PUBMED_API_KEY=

OPENFDA_RPM_LIMIT=40
OPENFDA_REQUEST_DELAY=1.5
OPENFDA_MAX_RETRIES=2
OPENFDA_TIMEOUT=30
OPENFDA_MAX_RESULTS=3
OPENFDA_API_KEY=

RESEARCH_CACHE_MINUTES=60

# --- Database & Storage Configuration ---
DATABASE_URL=sqlite:///./data/curapharm.db

# --- Application Server Configuration ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_BASE_URL=http://127.0.0.1:8000/api
